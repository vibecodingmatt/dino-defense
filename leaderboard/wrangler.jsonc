{
  "name": "dino-defense-leaderboard",
  "main": "worker.mjs",
  "compatibility_date": "2026-07-08",
  "account_id": "5448a82a740c95f92d6f39fff40a9031",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ALLOWED_ORIGINS": "https://vibecodingmatt.github.io"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "dino-defense-leaderboard",
